                            <label class="block text-xs font-semibold text-slate-600 uppercase mb-1">Select Role</label>
                            <select id="role-title" class="w-full px-4 py-3 border border-slate-200 rounded-2xl text-sm focus:border-teal-600 focus:outline-none bg-white">
                                <option>Primary Caregiver</option>
                                <option>Medicine Dispenser</option>
                                <option>Emergency Contact</option>
                                <option>Health Vitals Monitor</option>
                            </select>
                        </div>
                        <label class="flex items-center space-x-2 pt-2">
                            <input type="checkbox" id="role-notify" checked class="w-4 h-4 rounded text-teal-600 focus:ring-teal-500" />
                            <span class="text-xs text-slate-700 font-medium">Notify them to refill medicines</span>
                        </label>
                        <button onclick="confirmAddRole()" class="w-full bg-teal-600 hover:bg-teal-700 text-white font-semibold py-3.5 rounded-2xl shadow">Assign Role</button>
                    </div>
                </div>
            `;
        }

        function confirmAddRole() {
            const memberName = document.getElementById('role-member-name').value;
            const roleTitle = document.getElementById('role-title').value;
            const notifyRefill = document.getElementById('role-notify').checked;

            state.rolesList.push({ memberId: Date.now(), memberName, roleTitle, notifyRefill });
            closeModals();
            showToast('Role assigned successfully!');
            render();
        }

        function toggleNotifyRefill(idx) {
            state.rolesList[idx].notifyRefill = !state.rolesList[idx].notifyRefill;
            showToast('Refill notification preferences updated!');
        }

        function deleteRole(idx) {
            state.rolesList.splice(idx, 1);
            showToast('Role removed.');
            render();
        }

        function renderRoutinesView() {
            return `
                <div class="flex-1 flex flex-col bg-slate-50 overflow-y-auto pb-24 h-full">
                    <div class="bg-white px-6 pt-6 pb-4 border-b border-slate-100 shadow-sm flex justify-between items-center">
                        <div class="flex items-center space-x-3">
                            <button onclick="state.currentStep='space-dashboard'; render();" class="text-slate-400 hover:text-slate-600"><i class="fa-solid fa-arrow-left text-lg"></i></button>
                            <h1 class="font-bold text-slate-900 text-base">Daily Health Routine Checklist</h1>
                        </div>
                        <button onclick="showToast('Routines saved successfully!')" class="bg-teal-600 text-white hover:bg-teal-700 text-xs font-semibold px-3 py-2 rounded-xl transition shadow">Save</button>
                    </div>

                    <div class="p-6 space-y-4">
                        <p class="text-xs text-slate-500">Select which vital checks and routines are required for daily monitoring along with their timings.</p>
                        <div class="space-y-3">
                            ${state.routines.map((routine, idx) => `
                                <div class="bg-white p-4 border border-slate-200 rounded-2xl shadow-sm flex items-center justify-between">
                                    <div class="flex items-center space-x-3">
                                        <input type="checkbox" ${routine.enabled ? 'checked' : ''} onchange="toggleRoutine(${idx})" class="w-5 h-5 rounded text-teal-600 focus:ring-teal-500 cursor-pointer" />
                                        <div>
                                            <h3 class="font-bold text-slate-900 text-sm">${routine.name}</h3>
                                            <span class="text-xs text-slate-500">Scheduled: ${routine.timing}</span>
                                        </div>
                                    </div>
                                    <button onclick="editRoutineTiming(${idx})" class="text-xs bg-slate-100 text-slate-600 hover:bg-slate-200 px-3 py-1.5 rounded-xl font-medium">Edit Time</button>
                                </div>
                            `).join('')}
                        </div>
                    </div>

                    <!-- Bottom Nav -->
                    <div class="absolute bottom-0 left-0 right-0 bg-white border-t border-slate-200 py-3 px-6 flex justify-around items-center">
                        <button onclick="state.currentStep='space-dashboard'; render();" class="text-slate-400 hover:text-slate-600 flex flex-col items-center text-xs font-medium">
                            <i class="fa-solid fa-house text-lg mb-1"></i><span>Home</span>
                        </button>
                        <button onclick="state.currentStep='medicines'; render();" class="text-slate-400 hover:text-slate-600 flex flex-col items-center text-xs font-medium">
                            <i class="fa-solid fa-pills text-lg mb-1"></i><span>Meds</span>
                        </button>
                        <button onclick="state.currentStep='roles'; render();" class="text-slate-400 hover:text-slate-600 flex flex-col items-center text-xs font-medium">
                            <i class="fa-solid fa-user-shield text-lg mb-1"></i><span>Roles</span>
                        </button>
                        <button onclick="state.currentStep='routines'; render();" class="text-teal-600 flex flex-col items-center text-xs font-medium">
                            <i class="fa-solid fa-clipboard-list text-lg mb-1"></i><span>Routines</span>
                        </button>
                    </div>
                </div>
            `;
        }

        function toggleRoutine(idx) {
            state.routines[idx].enabled = !state.routines[idx].enabled;
            showToast(`${state.routines[idx].name} schedule updated.`);
        }

        function editRoutineTiming(idx) {
            const current = state.routines[idx];
            const newTiming = prompt(`Enter timing for ${current.name}:`, current.timing);
            if (newTiming) {
                current.timing = newTiming;
                showToast('Routine timing updated!');
                render();
            }
        }

        function renderSelfCareDashboard() {
            return `
                <div class="flex-1 flex flex-col bg-slate-50 overflow-y-auto pb-24 h-full">
                    <div class="bg-white px-6 pt-6 pb-4 border-b border-slate-100 shadow-sm flex justify-between items-center">
                        <div class="flex items-center space-x-3">
                            <div class="w-10 h-10 rounded-2xl bg-blue-600 text-white flex items-center justify-center font-bold shadow">
                                <i class="fa-solid fa-user"></i>
                            </div>
                            <div>
                                <h1 class="font-bold text-slate-900 text-base">My Self-Care Hub</h1>
                                <p class="text-xs text-slate-500">Personal Health & Medicine Tracker</p>
                            </div>
                        </div>
                        <button onclick="state.currentStep='profile-select'; render();" class="text-slate-400 hover:text-slate-600 text-xs font-medium">Switch Profile</button>
                    </div>

                    <div class="p-6 space-y-4">
                        <div class="grid grid-cols-2 gap-3">
                            <button onclick="state.currentStep='medicines'; render();" class="p-4 bg-white hover:bg-teal-50/50 border border-slate-200 rounded-2xl text-left transition shadow-sm group">
                                <div class="w-10 h-10 rounded-xl bg-teal-100 text-teal-600 flex items-center justify-center mb-3 group-hover:bg-teal-600 group-hover:text-white transition">
                                    <i class="fa-solid fa-pills"></i>
                                </div>
                                <h3 class="font-bold text-slate-900 text-sm">My Medicines</h3>
                                <p class="text-xs text-slate-500 mt-0.5">${state.medicines.length} active pills</p>
                            </button>

                            <button onclick="state.currentStep='routines'; render();" class="p-4 bg-white hover:bg-purple-50/50 border border-slate-200 rounded-2xl text-left transition shadow-sm group">
                                <div class="w-10 h-10 rounded-xl bg-purple-100 text-purple-600 flex items-center justify-center mb-3 group-hover:bg-purple-600 group-hover:text-white transition">
                                    <i class="fa-solid fa-clipboard-list"></i>
                                </div>
                                <h3 class="font-bold text-slate-900 text-sm">My Vitals Log</h3>
                                <p class="text-xs text-slate-500 mt-0.5">Daily health checks</p>
                            </button>
                        </div>

                        <!-- Personal Medicine Summary -->
                        <div class="bg-white p-5 border border-slate-200 rounded-3xl shadow-sm">
                            <h3 class="font-bold text-slate-900 text-sm mb-3">Today's Personal Schedule</h3>
                            <div class="space-y-2.5">
                                ${state.medicines.map(med => `
                                    <div class="flex items-center justify-between p-3 bg-slate-50 rounded-2xl border border-slate-100">
                                        <div class="flex items-center space-x-3">
                                            <div class="w-8 h-8 rounded-xl bg-blue-100 text-blue-600 flex items-center justify-center text-xs font-bold">
                                                <i class="fa-solid fa-pills"></i>
                                            </div>
                                            <div>
                                                <h4 class="font-semibold text-slate-900 text-xs">${med.name}</h4>
                                                <span class="text-[11px] text-slate-500">${med.dose} • ${med.timingHours}</span>
                                            </div>
                                        </div>
                                        <span class="text-[11px] font-medium px-2.5 py-1 rounded-full bg-emerald-100 text-emerald-700">Stock: ${med.balance}</span>
                                    </div>
                                `).join('')}
                            </div>
                        </div>
                    </div>

                    <!-- Bottom Nav -->
                    <div class="absolute bottom-0 left-0 right-0 bg-white border-t border-slate-200 py-3 px-6 flex justify-around items-center">
                        <button onclick="state.currentStep='self-care-dashboard'; render();" class="text-blue-600 flex flex-col items-center text-xs font-medium">
                            <i class="fa-solid fa-house text-lg mb-1"></i><span>Home</span>
                        </button>
                        <button onclick="state.currentStep='medicines'; render();" class="text-slate-400 hover:text-slate-600 flex flex-col items-center text-xs font-medium">
                            <i class="fa-solid fa-pills text-lg mb-1"></i><span>Meds</span>
                        </button>
                        <button onclick="state.currentStep='routines'; render();" class="text-slate-400 hover:text-slate-600 flex flex-col items-center text-xs font-medium">
                            <i class="fa-solid fa-clipboard-list text-lg mb-1"></i><span>Routines</span>
                        </button>
                    </div>
                </div>
            `;
        }

        // Initialize App on load
        window.onload = function() {
            render();
        };
    </script>
</body>
</html>
