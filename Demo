<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FamilyMed Care - Family Health & Caregiver Hub</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/js/all.min.js"></script>
    <style>
        body { font-family: 'Inter', sans-serif; }
        ::-webkit-scrollbar { width: 4px; height: 4px; }
        ::-webkit-scrollbar-track { background: #f1f5f9; }
        ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; }
        .app-container {
            max-width: 480px;
            margin: 0 auto;
            min-height: 100vh;
            background: #f8fafc;
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.1);
        }
        @media (min-width: 640px) {
            body {
                background: #0f172a;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 20px 0;
            }
            .app-container {
                border-radius: 40px;
                border: 8px solid #334155;
                height: 880px;
                max-height: 90vh;
                overflow: hidden;
            }
        }
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(8px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .animate-fade-in { animation: fadeIn 0.3s ease-out forwards; }
    </style>
</head>
<body class="h-full text-slate-800 antialiased">
    <div id="app" class="app-container flex flex-col relative overflow-hidden">
        <!-- Dynamic App Content Injected Here -->
    </div>

    <script>
        const state = {
            currentStep: 'onboarding', // onboarding, auth, otp, profile-select, care-group-setup, space-dashboard, medicines, roles, routines, self-care-dashboard
            onboardingIndex: 0,
            authMethod: null,
            phoneNumber: '',
            emailInput: '',
            otpValue: ['', '', '', ''],
            profileType: null, // 'care-group' or 'self-care'
            members: [
                { id: 1, name: 'Dr. Sarah (You)', role: 'Primary Admin', contact: 'sarah@familymed.com', notifyRefill: true }
            ],
            spaces: [
                { id: 1, name: 'Dad’s Care Space', patient: 'Robert Doe (Father)', condition: 'Hypertension & Diabetes' }
            ],
            currentSpaceId: 1,
            medicines: [
                { id: 1, name: 'Metformin 500mg', timings: ['Breakfast', 'Dinner'], dose: '1 tablet', balance: 24, total: 30, timingHours: '08:00 AM, 08:00 PM' },
                { id: 2, name: 'Amlodipine 5mg', timings: ['Breakfast'], dose: '1 tablet', balance: 12, total: 30, timingHours: '08:00 AM' }
            ],
            rolesList: [
                { memberId: 1, memberName: 'Dr. Sarah', roleTitle: 'Primary Caregiver', notifyRefill: true }
            ],
            routines: [
                { name: 'Blood Pressure (BP)', enabled: true, timing: '08:00 AM' },
                { name: 'Blood Sugar (Glucose)', enabled: true, timing: '07:30 AM' },
                { name: 'Weight Tracking', enabled: true, timing: '08:00 AM' },
                { name: 'Oxygen (SpO2)', enabled: false, timing: '09:00 PM' },
                { name: 'Temperature', enabled: false, timing: 'As needed' }
            ],
            inviteCode: 'FAM-' + Math.floor(1000 + Math.random() * 9000),
            modal: null, // { type, data }
            scanningPrescription: false
        };

        const onboardingSlides = [
            {
                title: "Coordinate Family Health Seamlessly",
                desc: "Care for aging parents or chronic conditions without chaos. Delegate tasks and monitor daily routines together in real time.",
                icon: "fa-hands-holding-child",
                color: "bg-teal-500"
            },
            {
                title: "Smart Medication & Inventory Tracking",
                desc: "Never miss a dose. Track stock levels, get automatic refill alerts, and scan prescriptions instantly with AI OCR.",
                icon: "fa-pills",
                color: "bg-blue-500"
            },
            {
                title: "Emergency-Ready Document Vault",
                desc: "Keep critical medical reports, prescriptions, and insurance IDs accessible instantly when sudden emergencies strike.",
                icon: "fa-shield-heart",
                color: "bg-indigo-500"
            }
        ];

        function showToast(message, type = 'success') {
            const existingToast = document.getElementById('toast-notification');
            if (existingToast) existingToast.remove();

            const toast = document.createElement('div');
            toast.id = 'toast-notification';
            toast.className = `fixed top-4 left-1/2 transform -translate-x-1/2 z-50 px-4 py-3 rounded-2xl shadow-xl text-white font-medium text-xs flex items-center space-x-2 transition-all duration-300 ${type === 'success' ? 'bg-teal-600' : 'bg-rose-600'}`;
            toast.innerHTML = `<i class="fa-solid ${type === 'success' ? 'fa-circle-check' : 'fa-circle-exclamation'} text-base"></i><span>${message}</span>`;
            document.body.appendChild(toast);
            setTimeout(() => { toast.style.opacity = '0'; setTimeout(() => toast.remove(), 300); }, 3000);
        }

        function render() {
            const app = document.getElementById('app');
            app.innerHTML = '';

            switch(state.currentStep) {
                case 'onboarding':
                    app.innerHTML = renderOnboarding();
                    break;
                case 'auth':
                    app.innerHTML = renderAuth();
                    break;
                case 'otp':
                    app.innerHTML = renderOTP();
                    break;
                case 'profile-select':
                    app.innerHTML = renderProfileSelect();
                    break;
                case 'care-group-setup':
                    app.innerHTML = renderCareGroupSetup();
                    break;
                case 'space-dashboard':
                    app.innerHTML = renderSpaceDashboard();
                    break;
                case 'medicines':
                    app.innerHTML = renderMedicinesView();
                    break;
                case 'roles':
                    app.innerHTML = renderRolesView();
                    break;
                case 'routines':
                    app.innerHTML = renderRoutinesView();
                    break;
                case 'self-care-dashboard':
                    app.innerHTML = renderSelfCareDashboard();
                    break;
            }
        }

        function renderOnboarding() {
            const slide = onboardingSlides[state.onboardingIndex];
            const isLast = state.onboardingIndex === onboardingSlides.length - 1;
            
            return `
                <div class="flex-1 flex flex-col justify-between p-6 bg-white h-full overflow-y-auto">
                    <div class="flex justify-between items-center py-2">
                        <span class="text-xs font-semibold tracking-wider text-teal-600 uppercase bg-teal-50 px-3 py-1 rounded-full">Step ${state.onboardingIndex + 1} of 3</span>
                        <button onclick="skipOnboarding()" class="text-slate-400 hover:text-slate-600 text-sm font-medium">Skip</button>
                    </div>

                    <div class="my-auto text-center py-6">
                        <div class="w-24 h-24 mx-auto mb-8 rounded-3xl ${slide.color} flex items-center justify-center text-white text-4xl shadow-xl shadow-teal-500/20 transform transition-all duration-500 hover:scale-105">
                            <i class="fa-solid ${slide.icon}"></i>
                        </div>
                        <h1 class="text-2xl font-bold text-slate-900 mb-3">${slide.title}</h1>
                        <p class="text-slate-600 text-sm leading-relaxed max-w-xs mx-auto">${slide.desc}</p>
                    </div>

                    <div class="space-y-4 pb-4">
                        <div class="flex justify-center space-x-2 mb-4">
                            ${onboardingSlides.map((_, i) => `<div class="h-1.5 rounded-full transition-all duration-300 ${i === state.onboardingIndex ? 'w-8 bg-teal-600' : 'w-2 bg-slate-200'}"></div>`).join('')}
                        </div>
                        <button onclick="nextOnboarding()" class="w-full bg-teal-600 hover:bg-teal-700 text-white font-semibold py-4 px-6 rounded-2xl shadow-lg shadow-teal-600/20 transition-all flex items-center justify-center space-x-2">
                            <span>${isLast ? 'Get Started' : 'Next'}</span>
                            <i class="fa-solid fa-arrow-right text-xs"></i>
                        </button>
                    </div>
                </div>
            `;
        }

        function nextOnboarding() {
            if (state.onboardingIndex < onboardingSlides.length - 1) {
                state.onboardingIndex++;
                render();
            } else {
                state.currentStep = 'auth';
                render();
            }
        }

        function skipOnboarding() {
            state.currentStep = 'auth';
            render();
        }

        function renderAuth() {
            return `
                <div class="flex-1 flex flex-col justify-between p-6 bg-white h-full overflow-y-auto">
                    <div class="pt-4">
                        <div class="w-14 h-14 bg-teal-50 rounded-2xl flex items-center justify-center text-teal-600 text-2xl mb-5">
                            <i class="fa-solid fa-heart-pulse"></i>
                        </div>
                        <h1 class="text-2xl font-bold text-slate-900 mb-2">Welcome to FamilyMed</h1>
                        <p class="text-slate-500 text-sm">Secure, centralized health & care management for your family.</p>
                    </div>

                    <div class="space-y-3 my-auto py-4">
                        <button onclick="handleSocialAuth('Google')" class="w-full flex items-center justify-center space-x-3 py-3.5 px-4 border border-slate-200 rounded-2xl hover:bg-slate-50 transition font-medium text-slate-700 text-sm shadow-sm">
                            <i class="fa-brands fa-google text-red-500 text-lg"></i>
                            <span>Continue with Google</span>
                        </button>
                        <button onclick="handleSocialAuth('Apple')" class="w-full flex items-center justify-center space-x-3 py-3.5 px-4 border border-slate-200 rounded-2xl hover:bg-slate-50 transition font-medium text-slate-700 text-sm shadow-sm">
                            <i class="fa-brands fa-apple text-slate-900 text-lg"></i>
                            <span>Continue with Apple ID</span>
                        </button>
                        <button onclick="openEmailAuth()" class="w-full flex items-center justify-center space-x-3 py-3.5 px-4 border border-slate-200 rounded-2xl hover:bg-slate-50 transition font-medium text-slate-700 text-sm shadow-sm">
                            <i class="fa-solid fa-envelope text-teal-600 text-lg"></i>
                            <span>Continue with Email</span>
                        </button>
                        
                        <div class="relative flex py-2 items-center">
                            <div class="flex-grow border-t border-slate-200"></div>
                            <span class="flex-shrink mx-4 text-xs text-slate-400 uppercase tracking-wider font-semibold">or mobile number</span>
                            <div class="flex-grow border-t border-slate-200"></div>
                        </div>

                        <div class="space-y-2">
                            <div class="flex rounded-2xl border border-slate-200 overflow-hidden focus-within:border-teal-500 shadow-sm">
                                <span class="bg-slate-50 px-4 py-3 text-slate-500 text-sm font-semibold flex items-center border-r border-slate-200">+91</span>
                                <input type="tel" id="phone-input" placeholder="Enter 10-digit mobile number" value="${state.phoneNumber}" class="w-full px-4 py-3 text-sm focus:outline-none" />
                            </div>
                            <button onclick="submitPhoneNumber()" class="w-full bg-teal-600 hover:bg-teal-700 text-white font-semibold py-3.5 px-6 rounded-2xl shadow-lg shadow-teal-600/20 transition">
                                Send 4-Digit SMS OTP
                            </button>
                        </div>
                    </div>

                    <p class="text-xs text-center text-slate-400 pb-2">By continuing, you agree to FamilyMed's Terms & Privacy Policy.</p>
                </div>
            `;
        }

        function handleSocialAuth(provider) {
            showToast(`Signed in with ${provider} successfully!`);
            state.currentStep = 'profile-select';
            render();
        }

        function openEmailAuth() {
            const email = prompt("Enter your email address:");
            if (email && email.includes('@')) {
                state.emailInput = email;
                state.currentStep = 'otp';
                showToast(`4-digit verification code sent to ${email}`);
                render();
            } else if (email) {
                showToast('Please enter a valid email address', 'error');
            }
        }

        function submitPhoneNumber() {
            const input = document.getElementById('phone-input').value.trim();
            if (input.length < 10) {
                showToast('Please enter a valid 10-digit mobile number', 'error');
                return;
            }
            state.phoneNumber = input;
            state.currentStep = 'otp';
            showToast('4-digit SMS OTP sent successfully!');
            render();
        }

        function renderOTP() {
            return `
                <div class="flex-1 flex flex-col justify-between p-6 bg-white h-full">
                    <div>
                        <button onclick="state.currentStep='auth'; render();" class="text-slate-400 hover:text-slate-600 mb-6 text-sm flex items-center space-x-1">
                            <i class="fa-solid fa-arrow-left"></i><span>Back</span>
                        </button>
                        <h1 class="text-2xl font-bold text-slate-900 mb-2">Verify Contact</h1>
                        <p class="text-slate-500 text-sm">Enter the 4-digit code sent to <span class="font-medium text-slate-800">${state.phoneNumber ? '+91 ' + state.phoneNumber : state.emailInput}</span></p>
                    </div>

                    <div class="my-auto space-y-6">
                        <div class="flex justify-center space-x-3">
                            ${[0, 1, 2, 3].map(i => `
                                <input type="text" maxlength="1" value="${state.otpValue[i]}" oninput="handleOtpInput(event, ${i})" id="otp-${i}" class="w-14 h-14 text-center text-xl font-bold border-2 border-slate-200 rounded-2xl focus:border-teal-600 focus:outline-none bg-slate-50 shadow-inner" />
                            `).join('')}
                        </div>
                        <div class="text-center">
                            <button onclick="showToast('Verification code re-sent successfully!')" class="text-teal-600 text-sm font-medium hover:underline">Didn't receive code? Resend SMS OTP</button>
                        </div>
                    </div>

                    <div>
                        <button onclick="verifyOTP()" class="w-full bg-teal-600 hover:bg-teal-700 text-white font-semibold py-4 px-6 rounded-2xl shadow-lg shadow-teal-600/20 transition">
                            Verify & Continue
                        </button>
                    </div>
                </div>
            `;
        }

        function handleOtpInput(e, idx) {
            const val = e.target.value;
            state.otpValue[idx] = val;
            if (val && idx < 3) {
                const nextInput = document.getElementById(`otp-${idx + 1}`);
                if (nextInput) nextInput.focus();
            }
        }

        function verifyOTP() {
            if (state.otpValue.some(v => !v)) {
                showToast('Please enter all 4 digits', 'error');
                return;
            }
            showToast('Verification successful!');
            state.currentStep = 'profile-select';
            render();
        }

        function renderProfileSelect() {
            return `
                <div class="flex-1 flex flex-col justify-between p-6 bg-white h-full">
                    <div class="pt-4">
                        <span class="text-xs font-semibold tracking-wider text-teal-600 uppercase bg-teal-50 px-3 py-1 rounded-full">Setup Profile</span>
                        <h1 class="text-2xl font-bold text-slate-900 mt-3 mb-2">How will you use FamilyMed?</h1>
                        <p class="text-slate-500 text-sm">Choose how you want to manage healthcare on this account.</p>
                    </div>

                    <div class="space-y-4 my-auto">
                        <div onclick="selectProfileType('care-group')" class="p-5 border-2 border-slate-200 hover:border-teal-600 rounded-3xl cursor-pointer transition group bg-white hover:bg-teal-50/30 shadow-sm">
                            <div class="flex items-start space-x-4">
                                <div class="w-12 h-12 rounded-2xl bg-teal-100 text-teal-600 flex items-center justify-center text-xl flex-shrink-0 group-hover:bg-teal-600 group-hover:text-white transition">
                                    <i class="fa-solid fa-users"></i>
                                </div>
                                <div>
                                    <h3 class="font-bold text-slate-900 mb-1 text-base">Create a Care Group</h3>
                                    <p class="text-slate-500 text-xs leading-relaxed">Manage care for aging parents or chronic patients with multi-member coordination & roles.</p>
                                </div>
                            </div>
                        </div>

                        <div onclick="selectProfileType('self-care')" class="p-5 border-2 border-slate-200 hover:border-blue-600 rounded-3xl cursor-pointer transition group bg-white hover:bg-blue-50/30 shadow-sm">
                            <div class="flex items-start space-x-4">
                                <div class="w-12 h-12 rounded-2xl bg-blue-100 text-blue-600 flex items-center justify-center text-xl flex-shrink-0 group-hover:bg-blue-600 group-hover:text-white transition">
                                    <i class="fa-solid fa-user"></i>
                                </div>
                                <div>
                                    <h3 class="font-bold text-slate-900 mb-1 text-base">Self Care</h3>
                                    <p class="text-slate-500 text-xs leading-relaxed">Directly track your personal medicines, health vitals, and daily wellness schedule.</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="pb-4 text-center">
                        <p class="text-xs text-slate-400">You can add or switch care profiles anytime in settings.</p>
                    </div>
                </div>
            `;
        }

        function selectProfileType(type) {
            state.profileType = type;
            if (type === 'care-group') {
                state.currentStep = 'care-group-setup';
            } else {
                state.currentStep = 'self-care-dashboard';
                showToast('Welcome to your Self Care dashboard!');
            }
            render();
        }

        function renderCareGroupSetup() {
            return `
                <div class="flex-1 flex flex-col justify-between p-6 bg-white overflow-y-auto h-full">
                    <div>
                        <div class="flex justify-between items-center mb-4">
                            <span class="text-xs font-semibold tracking-wider text-teal-600 uppercase bg-teal-50 px-3 py-1 rounded-full">Care Group Setup</span>
                            <button onclick="state.currentStep='profile-select'; render();" class="text-slate-400 text-sm font-medium">Back</button>
                        </div>
                        <h1 class="text-2xl font-bold text-slate-900 mb-2">Build Your Care Team</h1>
                        <p class="text-slate-500 text-sm mb-5">Add family members to share responsibilities and receive medication reminders.</p>

                        <!-- Share Code & Link Box -->
                        <div class="bg-teal-50 border border-teal-100 rounded-2xl p-4 mb-6 flex items-center justify-between shadow-sm">
                            <div>
                                <span class="text-xs font-semibold text-teal-800 uppercase block mb-1">Invite Family Code</span>
                                <span class="font-mono font-bold text-teal-900 text-lg">${state.inviteCode}</span>
                            </div>
                            <button onclick="showToast('Invite link and code copied to clipboard!')" class="bg-teal-600 hover:bg-teal-700 text-white text-xs font-semibold px-4 py-2.5 rounded-xl shadow">
                                <i class="fa-solid fa-share-nodes mr-1.5"></i>Share Link
                            </button>
                        </div>

                        <!-- Members List & Add CTA -->
                        <div class="space-y-3 mb-6">
                            <div class="flex justify-between items-center">
                                <h3 class="font-bold text-slate-800 text-sm">Members (${state.members.length})</h3>
                                <button onclick="openAddMemberModal()" class="text-teal-600 hover:text-teal-700 text-xs font-semibold flex items-center space-x-1">
                                    <i class="fa-solid fa-plus"></i><span>Add Member</span>
                                </button>
                            </div>

                            <div class="space-y-2">
                                ${state.members.map(m => `
                                    <div class="flex items-center justify-between p-3.5 bg-slate-50 border border-slate-100 rounded-2xl shadow-sm">
                                        <div class="flex items-center space-x-3">
                                            <div class="w-10 h-10 rounded-full bg-teal-600 text-white font-bold flex items-center justify-center text-sm">${m.name.charAt(0)}</div>
                                            <div>
                                                <h4 class="font-semibold text-slate-900 text-sm">${m.name}</h4>
                                                <span class="text-xs text-slate-500">${m.role}</span>
                                            </div>
                                        </div>
                                        <span class="text-xs bg-teal-100 text-teal-800 px-2.5 py-1 rounded-full font-medium">Active</span>
                                    </div>
                                `).join('')}
                            </div>
                        </div>
                    </div>

                    <div class="pt-4">
                        <button onclick="finishCareGroupSetup()" class="w-full bg-teal-600 hover:bg-teal-700 text-white font-semibold py-4 px-6 rounded-2xl shadow-lg shadow-teal-600/20 transition flex items-center justify-center space-x-2">
                            <span>Completed / Done</span>
                            <i class="fa-solid fa-arrow-right text-xs"></i>
                        </button>
                    </div>

                    ${state.modal && state.modal.type === 'add-member' ? renderAddMemberModal() : ''}
                </div>
            `;
        }

        function openAddMemberModal() {
            state.modal = { type: 'add-member' };
            render();
        }

        function closeModals() {
            state.modal = null;
            render();
        }

        function renderAddMemberModal() {
            return `
                <div class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-50 flex items-end sm:items-center justify-center p-0 sm:p-4">
                    <div class="bg-white w-full max-w-md rounded-t-3xl sm:rounded-3xl p-6 shadow-2xl animate-fade-in">
                        <div class="flex justify-between items-center mb-4">
                            <h3 class="font-bold text-slate-900 text-lg">Add Family Member</h3>
                            <button onclick="closeModals()" class="text-slate-400 hover:text-slate-600"><i class="fa-solid fa-xmark text-lg"></i></button>
                        </div>
                        <div class="space-y-4">
                            <div>
                                <label class="block text-xs font-semibold text-slate-600 uppercase mb-1">Member Name</label>
                                <input type="text" id="new-member-name" placeholder="e.g. Priya Doe (Sister)" class="w-full px-4 py-3 border border-slate-200 rounded-2xl text-sm focus:border-teal-600 focus:outline-none" />
                            </div>
                            <div>
                                <label class="block text-xs font-semibold text-slate-600 uppercase mb-1">Email or Mobile</label>
                                <input type="text" id="new-member-contact" placeholder="email@example.com or mobile" class="w-full px-4 py-3 border border-slate-200 rounded-2xl text-sm focus:border-teal-600 focus:outline-none" />
                            </div>
                            <div>
                                <label class="block text-xs font-semibold text-slate-600 uppercase mb-1">Role in Care Group</label>
                                <select id="new-member-role" class="w-full px-4 py-3 border border-slate-200 rounded-2xl text-sm focus:border-teal-600 focus:outline-none bg-white">
                                    <option>Primary Caregiver</option>
                                    <option>Medicine Dispenser</option>
                                    <option>Emergency Contact</option>
                                    <option>Health Vitals Monitor</option>
                                    <option>Observer / Family Viewer</option>
                                </select>
                            </div>
                            <button onclick="confirmAddMember()" class="w-full bg-teal-600 hover:bg-teal-700 text-white font-semibold py-3.5 rounded-2xl shadow">Add Member</button>
                        </div>
                    </div>
                </div>
            `;
        }

        function confirmAddMember() {
            const name = document.getElementById('new-member-name').value.trim();
            const contact = document.getElementById('new-member-contact').value.trim();
            const role = document.getElementById('new-member-role').value;
            if (!name) {
                showToast('Please enter member name', 'error');
                return;
            }
            state.members.push({ id: Date.now(), name, contact, role });
            closeModals();
            showToast(`${name} added successfully!`);
        }

        function finishCareGroupSetup() {
            state.currentStep = 'space-dashboard';
            showToast('Care Group & Space initialized!');
            render();
        }

        function renderSpaceDashboard() {
            const space = state.spaces[0];
            return `
                <div class="flex-1 flex flex-col bg-slate-50 overflow-y-auto pb-24 h-full">
                    <!-- Top Header -->
                    <div class="bg-white px-6 pt-6 pb-4 border-b border-slate-100 shadow-sm">
                        <div class="flex justify-between items-center mb-2">
                            <div class="flex items-center space-x-3">
                                <div class="w-10 h-10 rounded-2xl bg-teal-600 text-white flex items-center justify-center font-bold shadow">
                                    <i class="fa-solid fa-house-medical"></i>
                                </div>
                                <div>
                                    <h1 class="font-bold text-slate-900 text-base">${space.name}</h1>
                                    <p class="text-xs text-slate-500">Patient: ${space.patient}</p>
                                </div>
                            </div>
                            <button onclick="openCreateSpaceModal()" class="text-teal-600 bg-teal-50 hover:bg-teal-100 text-xs font-semibold px-3 py-2 rounded-xl transition">
